NODE_ENV=development
NOPAGER_BASE_URL=http://localhost:3000
NOPAGER_SERVER_ADDR=0.0.0.0:8080
NOPAGER_API_URL=http://localhost:8080/
NOPAGER_API_PORT=8080
NOPAGER_WEB_BIND=0.0.0.0
NOPAGER_WEB_PORT=3000
NOPAGER_MASTER_KEY=
# Generate with `cargo run -p nopager-cli -- init` or any CSPRNG that emits
# exactly 32 bytes encoded as standard base64. Never reuse this key elsewhere.
NOPAGER_ADMIN_TOKEN=
NOPAGER_COOKIE_SECURE=false
DATABASE_URL=postgresql://nopager:nopager@postgres:5432/nopager

# GitHub App. GITHUB_WEBHOOK_SECRET is required for signed workflow-run events.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Vercel. VERCEL_TEAM_ID is optional for personal-account projects.
# VERCEL_WEBHOOK_SECRET is optional; deployment polling remains enabled.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_WEBHOOK_SECRET=

# Optional default provider keys for local self-host
NOPAGER_AI_PROVIDER=openai
NOPAGER_AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Security / runtime
SANDBOX_MAX_CPU=2
SANDBOX_MAX_MEMORY_MB=4096
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_UID_GID=10001:10001
NOPAGER_WORK_ROOT=
NOPAGER_SANDBOX_VOLUME=
DOCKER_GID=999
RUST_LOG=info
